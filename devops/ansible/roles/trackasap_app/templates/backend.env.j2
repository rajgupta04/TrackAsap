NODE_ENV=production
PORT={{ backend_internal_port }}
MONGODB_URI={{ vault_mongodb_uri | default('mongodb://localhost:27017/trackasap') }}
REDIS_URI={{ vault_redis_uri | default('redis://redis:6379') }}
JWT_SECRET={{ vault_jwt_secret | default('replace_via_ansible_vault') }}
JWT_EXPIRE=30d
FRONTEND_URL={{ vault_frontend_url | default('https://trackasap.in') }}
BACKEND_URL={{ vault_backend_url | default('https://api.trackasap.in') }}
LIVEKIT_URL={{ vault_livekit_url | default('ws://livekit-server:7880') }}
LIVEKIT_API_KEY={{ vault_livekit_api_key | default('devkey') }}
LIVEKIT_API_SECRET={{ vault_livekit_api_secret | default('secret') }}
