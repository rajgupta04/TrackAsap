{
  "uid": "trackasap-overview",
  "title": "TrackAsap DevOps & API Observability",
  "tags": ["trackasap", "nodejs", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "MongoDB Status",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "trackasap_db_connected", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "CONNECTED", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Redis Cache Status",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "trackasap_redis_connected", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "READY", "color": "green" }, "0": { "text": "FAIL-OPEN", "color": "orange" } } }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In-Flight Requests",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "trackasap_http_requests_in_flight", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Process Uptime (sec)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "trackasap_process_uptime_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Rate by Status Code (req/s)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(trackasap_http_requests_total[1m]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API Latency P95 & P50 (seconds)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(trackasap_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(trackasap_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Node.js Memory (Heap Used vs RSS)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "trackasap_nodejs_heap_used_bytes", "legendFormat": "Heap Used", "refId": "A" },
        { "expr": "trackasap_nodejs_rss_bytes", "legendFormat": "RSS", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Event Loop Lag & Analytics Queue Backlog",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "trackasap_nodejs_event_loop_lag_seconds", "legendFormat": "Event Loop Lag (s)", "refId": "A" },
        { "expr": "trackasap_analytics_queue_size", "legendFormat": "Queue {{queue}}", "refId": "B" }
      ]
    }
  ]
}
