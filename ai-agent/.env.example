# TrackAsap AI Live Interviewer Environment Configuration

# LiveKit Configuration (Self-Hosted on Azure VM or LiveKit Cloud)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Free Tier LLM & STT Providers
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Models (Optimized for low-latency free-tier voice agents)
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
GEMINI_LLM_MODEL=gemini-2.0-flash

# TrackAsap Backend API Integration
TRACKASAP_API_URL=http://localhost:5000/api
AI_AGENT_INTERNAL_SECRET=trackasap_ai_secret_key

# Kokoro TTS Configuration
KOKORO_VOICE=am_adam
KOKORO_SPEED=1.05
