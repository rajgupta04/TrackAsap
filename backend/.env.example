# ==========================================
# TrackAsap Backend Production Environment Variables
# ==========================================

# Core Server Config
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trackasap?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRE=30d

# App Domain URLs
BACKEND_URL=https://api.trackasap.in
FRONTEND_URL=https://trackasap.in

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# GitHub Integration
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=https://api.trackasap.in/api/github/callback
GITHUB_TOKEN_ENC_KEY=64_character_hex_key_for_aes_256_gcm_encryption

# Cloudinary (Problem Setter Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mailer Settings (Titan / Custom SMTP)
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_USER=admin@trackasap.in
SMTP_PASS=your_email_password
WELCOME_FROM_EMAIL=raj@trackasap.in

# Optional Local / Self-Hosted Services
# PISTON_URL=http://127.0.0.1:2000
# REDIS_URI=redis://127.0.0.1:6379

